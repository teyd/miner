# The miner's environment, read by Varlock (https://varlock.dev).
# This file is committed and holds no values. Put values in .env.local, which git ignores,
# and encrypt secrets there with `pnpm exec varlock encrypt`.
# @defaultRequired=false @defaultSensitive=false
# ---

# A Twitch access token issued to Twitch's Android client (implicit grant), copied from a
# browser login. During development, a test account's token only.
# @required @sensitive
# @type=string(matches=regex("^[a-z0-9]{20,40}$"))
TOKEN=

# Where config.json, state and recordings live. In Docker, mount a volume here.
# @type=string
DATA_DIR=./data

# Logs go to stderr. Least severe level written: Trace, Debug, Info, Warn, Error, Fatal or None.
# @type=enum(Trace, Debug, Info, Warn, Error, Fatal, None)
LOG_LEVEL=Info

# `pretty` (one readable line per entry) or `json` (one object per line). Unset: pretty when
# stderr is a terminal, json otherwise, so `pnpm dev` is pretty and Docker gets JSON.
# @type=enum(pretty, json)
LOG_FORMAT=

# Also write JSON logs to $DATA_DIR/logs/miner.log, rotated at 10 MiB, 5 old files kept.
# Turn off when Docker or journald already keeps the stderr logs.
# @type=boolean
LOG_FILE=true

# `miner sim`: the first seed, how many seeds to run, and a capsule file to replay instead.
# The flags --seed, --seeds and --trace win over these.
# @type=number(isInt=true)
MINER_SIM_SEED=
# @type=number(isInt=true)
MINER_SIM_SEEDS=
# @type=string
MINER_SIM_TRACE=
